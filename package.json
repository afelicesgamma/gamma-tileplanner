  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "translate": "npm run translate:pot && npm run translate:js",
    "translate:pot": "wp i18n make-pot . ./languages/gamma-tileplanner.pot --ignore-domain --include=\"react,resources\"",
    "translate:js": "wp i18n make-json ./languages --pretty-print"
  },
